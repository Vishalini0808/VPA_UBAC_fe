<mvc:View
    controllerName="vpauseraccess.controller.ubac"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">

    <Page id="page"
          title="{access>/title}"
          showNavButton="true"
          navButtonPress=".onNavBack">
        <content>
            <VBox class="sapUiMediumMargin" width="100%">

                <Text text="{access>/userText}" class="sapUiSmallMarginBottom" />

                <MessageStrip text="{access>/error}"
                              type="Error"
                              showIcon="true"
                              visible="{= !!${access>/error} }"
                              class="sapUiSmallMarginBottom" />

                <!-- loading -->
                <Text text="Checking your access..."
                      visible="{= ${access>/screen} === 'loading' &amp;&amp; !${access>/error} }" />

                <!-- no access / coming soon / unknown -->
                <VBox visible="{= ${access>/screen} === 'message' }">
                    <Title text="{access>/messageTitle}" level="H2" class="sapUiSmallMarginBottom" />
                    <Text text="{access>/messageText}" />
                </VBox>

                <!-- Master Data: 2 tiles (admin) -->
                <HBox wrap="Wrap" visible="{= ${access>/screen} === 'masterData' }">
                    <GenericTile
                        class="sapUiSmallMarginEnd sapUiSmallMarginBottom"
                        frameType="TwoByOne"
                        header="Master Data Submitter"
                        subheader="Create and maintain master data"
                        visible="{access>/dest/masterData_submit/visible}"
                        state="{access>/dest/masterData_submit/state}"
                        press=".onDestinationPress">
                        <customData>
                            <core:CustomData key="dest" value="masterData.submit" />
                        </customData>
                        <TileContent footer="{access>/dest/masterData_submit/note}">
                            <ImageContent src="sap-icon://database" />
                        </TileContent>
                    </GenericTile>

                    <GenericTile
                        class="sapUiSmallMarginEnd sapUiSmallMarginBottom"
                        frameType="TwoByOne"
                        header="Master Data Approver"
                        subheader="Approval dashboard"
                        visible="{access>/dest/masterData_approve/visible}"
                        state="{access>/dest/masterData_approve/state}"
                        press=".onDestinationPress">
                        <customData>
                            <core:CustomData key="dest" value="masterData.approve" />
                        </customData>
                        <TileContent footer="{access>/dest/masterData_approve/note}">
                            <ImageContent src="sap-icon://approvals" />
                        </TileContent>
                    </GenericTile>
                </HBox>

                <!-- Pricing: 2 tiles (admin) -->
                <HBox wrap="Wrap" visible="{= ${access>/screen} === 'pricing' }">
                    <GenericTile
                        class="sapUiSmallMarginEnd sapUiSmallMarginBottom"
                        frameType="TwoByOne"
                        header="Pricing Submitter"
                        subheader="Calculate and submit pricing"
                        visible="{access>/dest/pricing_submit/visible}"
                        state="{access>/dest/pricing_submit/state}"
                        press=".onDestinationPress">
                        <customData>
                            <core:CustomData key="dest" value="pricing.submit" />
                        </customData>
                        <TileContent footer="{access>/dest/pricing_submit/note}">
                            <ImageContent src="sap-icon://money-bills" />
                        </TileContent>
                    </GenericTile>

                    <GenericTile
                        class="sapUiSmallMarginEnd sapUiSmallMarginBottom"
                        frameType="TwoByOne"
                        header="Pricing Approver"
                        subheader="Approval dashboard"
                        visible="{access>/dest/pricing_approve/visible}"
                        state="{access>/dest/pricing_approve/state}"
                        press=".onDestinationPress">
                        <customData>
                            <core:CustomData key="dest" value="pricing.approve" />
                        </customData>
                        <TileContent footer="{access>/dest/pricing_approve/note}">
                            <ImageContent src="sap-icon://approvals" />
                        </TileContent>
                    </GenericTile>
                </HBox>

                <!-- UBAC admin screen -->
                <VBox visible="{= ${access>/screen} === 'ubac' }">
                    <Title text="Add assignment" level="H3" class="sapUiSmallMarginBottom" />

                    <HBox alignItems="Center" wrap="Wrap" class="sapUiSmallMarginBottom">
                        <Input value="{access>/admin/newEmail}"
                               type="Email"
                               placeholder="user@company.com"
                               width="20rem"
                               class="sapUiSmallMarginEnd"
                               submit=".onAddUser" />

                        <Select selectedKey="{access>/admin/newRole}"
                                forceSelection="false"
                                width="14rem"
                                class="sapUiSmallMarginEnd"
                                items="{access>/admin/roles}">
                            <core:Item key="{access>key}" text="{access>key}" />
                        </Select>

                        <Button text="Add"
                                icon="sap-icon://add"
                                type="Emphasized"
                                press=".onAddUser" />
                    </HBox>

                    <Table id="tblUserRoles"
                           items="{access>/admin/items}"
                           busy="{access>/admin/busy}"
                           mode="Delete"
                           delete=".onDeleteUser"
                           noDataText="No assignments found"
                           growing="true"
                           growingThreshold="20">
                        <headerToolbar>
                            <Toolbar>
                                <Title text="User role assignments" />
                            </Toolbar>
                        </headerToolbar>
                        <columns>
                            <Column><Text text="Email" /></Column>
                            <Column><Text text="Role" /></Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Text text="{access>userId}" />
                                    <Text text="{access>role}" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </VBox>

            </VBox>
        </content>
    </Page>
</mvc:View>