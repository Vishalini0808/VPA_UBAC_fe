{
  "_version": "1.89.0",
  "sap.app": {
    "id": "vpauseraccess",
    "type": "application",
    "i18n": {
      "bundleUrl": "i18n/i18n.properties",
      "supportedLocales": [
        ""
      ],
      "fallbackLocale": ""
    },
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.33.0",
      "toolsId": "17fe9ceb-e4b9-4c07-81cd-ae3cf16c53b1"
    },
    "crossNavigation": {
      "inbounds": {
        "VPAMasterDataHub-display": {
          "semanticObject": "VPAMasterDataHub",
          "action": "display",
          "title": "VPA",
          "subTitle": "Master data applications",
          "icon": "sap-icon://database",
          "signature": {
            "parameters": {
              "mode": {
                "defaultValue": {
                  "value": "masterData"
                },
                "required": false
              }
            },
            "additionalParameters": "allowed"
          }
        },
        "VPAPricingHub-display": {
          "semanticObject": "VPAPricingHub",
          "action": "display",
          "title": "Pricing Calculation",
          "subTitle": "Pricing applications",
          "icon": "sap-icon://money-bills",
          "signature": {
            "parameters": {
              "mode": {
                "defaultValue": {
                  "value": "pricing"
                },
                "required": false
              }
            },
            "additionalParameters": "allowed"
          }
        },
        "VPAUserAccess-manage": {
          "semanticObject": "VPAUserAccess",
          "action": "manage",
          "title": "UBAC",
          "subTitle": "Manage user access",
          "icon": "sap-icon://user-settings",
          "signature": {
            "parameters": {
              "mode": {
                "defaultValue": {
                  "value": "ubac"
                },
                "required": false
              }
            },
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.153.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "vpauseraccess.i18n.i18n",
          "supportedLocales": [
            ""
          ],
          "fallbackLocale": ""
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "vpauseraccess.view",
        "async": true,
        "viewPath": "vpauseraccess.view"
      },
      "routes": [
        {
          "name": "Routeubac",
          "pattern": ":?query:",
          "target": [
            "Targetubac"
          ]
        }
      ],
      "targets": {
        "Targetubac": {
          "id": "ubac",
          "name": "ubac"
        }
      }
    },
    "rootView": {
      "viewName": "vpauseraccess.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "vpauseraccess"
  }
}